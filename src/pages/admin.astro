---
// Halaman Admin CMS Benchtekno
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — Benchtekno CMS</title>
    <style>
        :root {
            --bg-color: #07090e;
            --card-bg: #0f172a;
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #1e293b;
            --accent: #38bdf8;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            padding: 0;
        }
        .btn-primary {
            background-color: var(--accent);
            color: #07090e;
            font-weight: 700;
            padding: 10px 18px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
            transition: opacity 0.2s;
        }
        .btn-primary:hover {
            opacity: 0.9;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px;
        }
        input, select, textarea {
            width: 100%;
            background-color: #07090e;
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
            box-sizing: border-box;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--accent);
        }
    </style>
</head>
<body style="min-height: 100vh; display: flex; flex-direction: column;">

    <!-- Header / Navbar -->
    <header style="border-bottom: 1px solid var(--border-color); background-color: var(--card-bg); position: sticky; top: 0; z-index: 50;">
        <div style="max-width: 1200px; margin: 0 auto; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 1.25rem; font-weight: 900; color: #ffffff; font-family: monospace;">Bench<span style="color: var(--accent);">tekno</span></span>
                <span style="background: rgba(56,189,248,0.1); color: var(--accent); font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; border: 1px solid rgba(56,189,248,0.2);">News CMS</span>
            </div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <span style="font-size: 0.85rem; color: var(--text-muted);">Git-as-CMS Workflow</span>
                <a href="/" style="font-size: 0.85rem; background: #1e293b; color: #f8fafc; padding: 6px 14px; border-radius: 8px; text-decoration: none; border: 1px solid var(--border-color);">Preview Site</a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main style="max-width: 1200px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box;">
        
        <!-- Page Title & Actions -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 16px;">
            <div>
                <h1 style="font-size: 1.8rem; font-weight: 900; margin: 0 0 6px 0; color: #ffffff;">Article & News Manager</h1>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0;">Buat, sunting, dan kelola berita teknologi langsung dari dashboard.</p>
            </div>
            <button onclick="openEditorModal()" class="btn-primary" style="display: flex; align-items: center; gap: 8px;">
                + Tulis Berita Baru (.md)
            </button>
        </div>

        <!-- Quick Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div class="card">
                <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700; margin: 0 0 8px 0;">Total Berita</p>
                <h3 style="font-size: 2rem; font-weight: 800; margin: 0; color: #ffffff;">8</h3>
                <span style="font-size: 0.75rem; color: #34d399; margin-top: 8px; display: inline-block;">+3 minggu ini</span>
            </div>
            <div class="card">
                <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700; margin: 0 0 8px 0;">Direktori CMS</p>
                <h3 style="font-size: 0.95rem; font-family: monospace; font-weight: 800; margin: 0; color: var(--accent);">src/content/articles/</h3>
                <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 8px; display: inline-block;">Sinkronisasi Git</span>
            </div>
            <div class="card">
                <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700; margin: 0 0 8px 0;">Penyimpanan Gambar</p>
                <h3 style="font-size: 0.95rem; font-family: monospace; font-weight: 800; margin: 0; color: #38bdf8;">public/images/</h3>
                <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 8px; display: inline-block;">Aset Lokal Aktif</span>
            </div>
            <div class="card">
                <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); font-weight: 700; margin: 0 0 8px 0;">Status Deployment</p>
                <h3 style="font-size: 2rem; font-weight: 800; margin: 0; color: #34d399;">Live</h3>
                <span style="font-size: 0.75rem; color: var(--text-muted); margin-top: 8px; display: inline-block;">Vercel Production</span>
            </div>
        </div>

        <!-- Article Management Table -->
        <section class="card" style="padding: 0; overflow: hidden;">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: #ffffff;">Daftar Publikasi Berita</h2>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Urutan berdasarkan tanggal terbaru</span>
            </div>
            
            <div style="overflow-x-auto;">
                <table style="width: 100%; text-align: left; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border-color); font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); background: rgba(15,23,42,0.5);">
                            <th style="padding: 14px 20px;">Judul Berita</th>
                            <th style="padding: 14px 20px;">Kategori</th>
                            <th style="padding: 14px 20px;">Tanggal</th>
                            <th style="padding: 14px 20px;">Status</th>
                            <th style="padding: 14px 20px; text-align: right;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.9rem;">
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 16px 20px; font-weight: 600; color: #ffffff;">NVIDIA RTX 5090 Mobile Benchmarks: Lonjakan Performa Grafis Laptop</td>
                            <td style="padding: 16px 20px;"><span style="background: rgba(56,189,248,0.1); color: var(--accent); padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; border: 1px solid rgba(56,189,248,0.2);">Smartphones</span></td>
                            <td style="padding: 16px 20px; color: var(--text-muted);">Nov 8, 2026</td>
                            <td style="padding: 16px 20px;"><span style="color: #34d399; font-size: 0.8rem; font-weight: 600;">● Published</span></td>
                            <td style="padding: 16px 20px; text-align: right;">
                                <button onclick="alert('Membuka file markdown...')" style="background:none; border:none; color: var(--text-muted); cursor:pointer; font-weight:600; margin-right:10px;">Edit</button>
                                <button onclick="alert('Menghapus artikel...')" style="background:none; border:none; color: #f43f5e; cursor:pointer; font-weight:600;">Hapus</button>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 20px; font-weight: 600; color: #ffffff;">Snapdragon 8 Gen 5 Resmi Diumumkan dengan Arsitektur Core Baru</td>
                            <td style="padding: 16px 20px;"><span style="background: rgba(168,85,247,0.1); color: #c084fc; padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; border: 1px solid rgba(168,85,247,0.2);">Chipsets</span></td>
                            <td style="padding: 16px 20px; color: var(--text-muted);">Nov 7, 2026</td>
                            <td style="padding: 16px 20px;"><span style="color: #34d399; font-size: 0.8rem; font-weight: 600;">● Published</span></td>
                            <td style="padding: 16px 20px; text-align: right;">
                                <button onclick="alert('Membuka file markdown...')" style="background:none; border:none; color: var(--text-muted); cursor:pointer; font-weight:600; margin-right:10px;">Edit</button>
                                <button onclick="alert('Menghapus artikel...')" style="background:none; border:none; color: #f43f5e; cursor:pointer; font-weight:600;">Hapus</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- Modal / Drawer Form Input Berita -->
    <div id="editor-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(4px); z-index: 100; align-items: center; justify-content: center; padding: 20px;">
        <div class="card" style="width: 100%; max-width: 700px; max-height: 90vh; overflow-y: auto; box-sizing: border-box; padding: 0;">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(15,23,42,0.5);">
                <h3 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: #ffffff;">Form Input Berita Baru</h3>
                <button onclick="closeEditorModal()" style="background:none; border:none; color:var(--text-muted); font-size:1.5rem; cursor:pointer;">&times;</button>
            </div>
            
            <div style="padding: 24px; display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <label style="display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Judul Berita (Title)</label>
                    <input type="text" id="news-title" placeholder="Contoh: Ulasan Eksklusif Smartphone Flagship Terbaru...">
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Kategori</label>
                        <select id="news-category">
                            <option value="Smartphones">Smartphones & Mobiles</option>
                            <option value="Gadgets">Gadgets & Wearables</option>
                            <option value="Chipsets">Chipsets & Hardware</option>
                            <option value="Industry">Industry Insights</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Tanggal Publikasi</label>
                        <input type="date" id="news-date">
                    </div>
                </div>

                <div>
                    <label style="display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Ringkasan Berita (Description)</label>
                    <textarea id="news-desc" rows="2" placeholder="Tulis deskripsi singkat yang menarik pembaca..."></textarea>
                </div>

                <div>
                    <label style="display: block; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Isi Konten Berita (Markdown Format)</label>
                    <textarea id="news-content" rows="5" placeholder="Tulis isi berita lengkap di sini..." style="font-family: monospace; font-size: 0.85rem;"></textarea>
                </div>

                <!-- Generated Markdown Output Box -->
                <div style="background: #07090e; padding: 16px; border-radius: 10px; border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--accent);">Hasil Kode Markdown (.md)</span>
                        <button onclick="copyMarkdown()" style="font-size: 0.75rem; background: #1e293b; color: #fff; border: 1px solid var(--border-color); padding: 4px 10px; border-radius: 6px; cursor: pointer;">Salin Kode</button>
                    </div>
                    <pre id="markdown-output" style="font-size: 0.75rem; font-family: monospace; color: #cbd5e1; overflow-x: auto; white-space: pre-wrap; background: #030712; padding: 12px; border-radius: 8px; border: 1px solid rgba(30,41,59,0.5); margin: 0;">---
title: "Judul Berita"
description: "Ringkasan berita..."
publishDate: 2026-11-08
category: "Smartphones"
---

Tulis konten berita lengkap di sini...</pre>
                </div>
            </div>

            <div style="padding: 16px 24px; border-top: 1px solid var(--border-color); background: rgba(15,23,42,0.5); display: flex; justify-content: flex-end; gap: 12px;">
                <button onclick="closeEditorModal()" style="background: #1e293b; color: #fff; border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 0.85rem;">Tutup</button>
                <button onclick="alert('Salin kode markdown di atas lalu buat file .md baru di folder src/content/articles/ di GitHub!')" class="btn-primary" style="padding: 8px 16px; font-size: 0.85rem;">Simpan & Panduan Git</button>
            </div>
        </div>
    </div>

    <!-- Script Modal & Generator -->
    <script>
        const modal = document.getElementById('editor-modal');
        const titleInput = document.getElementById('news-title');
        const catInput = document.getElementById('news-category');
        const dateInput = document.getElementById('news-date');
        const descInput = document.getElementById('news-desc');
        const contentInput = document.getElementById('news-content');
        const outputPre = document.getElementById('markdown-output');

        dateInput.valueAsDate = new Date();

        function openEditorModal() {
            modal.style.display = 'flex';
            updateMarkdownPreview();
        }

        function closeEditorModal() {
            modal.style.display = 'none';
        }

        function updateMarkdownPreview() {
            const title = titleInput.value || 'Judul Berita';
            const category = catInput.value;
            const date = dateInput.value || '2026-11-08';
            const desc = descInput.value || 'Ringkasan berita...';
            const content = contentInput.value || 'Tulis konten berita lengkap di sini...';

            const mdText = `---
title: "${title}"
description: "${desc}"
publishDate: ${date}
category: "${category}"
---

${content}`;

            outputPre.textContent = mdText;
        }

        [titleInput, catInput, dateInput, descInput, contentInput].forEach(el => {
            el.addEventListener('input', updateMarkdownPreview);
        });

        function copyMarkdown() {
            navigator.clipboard.writeText(outputPre.textContent);
            alert('Kode Markdown berhasil disalin ke clipboard!');
        }
    </script>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--border-color); padding: 20px; text-align: center; font-size: 0.75rem; color: var(--text-muted); margin-top: auto;">
        &copy; 2026 Benchtekno Admin Panel. Powered by Astro & Vercel.
    </footer>

</body>
</html>
