---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featured = sortedArticles[0];
const others = sortedArticles.slice(1);
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benchtekno — Global Tech Media & Hardware Reviews</title>
</head>
<body style="background-color: #07090e; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0;">

    <!-- Main Header & Navigation -->
    <header style="border-bottom: 1px solid #1e293b; background-color: #0b0f17; position: sticky; top: 0; z-index: 50;">
        <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 18px 20px;">
            <a href="/" style="font-size: 1.5rem; font-weight: 900; letter-spacing: 1px; color: #ffffff; text-decoration: none;">
                benchtekno
            </a>
            <nav style="display: flex; gap: 24px; font-size: 0.9rem;">
                <span style="color: #94a3b8; cursor: pointer;">Global Hardware</span>
                <span style="color: #94a3b8; cursor: pointer;">Benchmarks</span>
                <span style="color: #38bdf8; font-weight: 600; cursor: pointer;">Latest</span>
                <span style="color: #94a3b8; cursor: pointer;">About</span>
            </nav>
        </div>
    </header>

    <main style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
        
        <!-- Hero Section -->
        <section style="margin-bottom: 60px;">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #38bdf8; margin-bottom: 12px;">
                DATA-DRIVEN HARDWARE COMPARISONS
            </div>
            
            <h1 style="font-size: 3rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.15; max-width: 900px;">
                Understand the hardware behind the device.
            </h1>
            
            <p style="color: #94a3b8; font-size: 1.15rem; line-height: 1.6; margin: 0 0 24px 0; max-width: 800px;">
                Benchtekno delivers daily visual benchmark breakdowns, thermal performance analytics, and deep mobile chipset research on high-end hardware.
            </p>

            <div style="display: flex; gap: 16px; align-items: center; font-size: 0.85rem; color: #64748b; margin-bottom: 30px;">
                <span style="background: rgba(30, 41, 59, 0.6); padding: 6px 12px; border-radius: 6px; border: 1px solid #1e293b;">Performance Benchmarks</span>
                <span style="background: rgba(30, 41, 59, 0.6); padding: 6px 12px; border-radius: 6px; border: 1px solid #1e293b;">Not financial advice</span>
            </div>

            <p style="color: #64748b; font-size: 0.85rem; margin: 0;">
                While others lock their insights behind paywalls and sign-up forms, we give you the analysis upfront.
            </p>
        </section>

        <!-- Editor's Selection / Featured Research -->
        {featured && (
            <section style="margin-bottom: 70px;">
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b; margin-bottom: 16px;">
                    EDITOR'S SELECTION
                </div>
                
                <div style="background-color: #0f172a; border: 1px solid #1e293b; border-radius: 16px; overflow: hidden;">
                    <div style="width: 100%; height: 360px; background-color: #090d16; border-bottom: 1px solid #1e293b; display: flex; align-items: center; justify-content: center; color: #475569; font-family: monospace; font-size: 0.9rem;">
                        [Featured Hardware Thumbnail / Banner]
                    </div>
                    
                    <div style="padding: 36px;">
                        <div style="display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; background: rgba(6, 182, 212, 0.1); padding: 4px 10px; border-radius: 6px; margin-bottom: 12px; border: 1px solid rgba(6, 182, 212, 0.2);">
                            {featured.data.category}
                        </div>
                        
                        <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.3;">
                            {featured.data.title}
                        </h2>
                        
                        <div style="display: flex; gap: 16px; align-items: center; font-size: 0.85rem; color: #64748b; margin-bottom: 20px;">
                            <span style="color: #38bdf8; font-weight: 600;">$TECH</span>
                            <span>{featured.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                            <span>4 min read</span>
                        </div>
                        
                        <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.7; margin: 0 0 24px 0;">
                            {featured.data.description}
                        </p>
                        
                        <a href={`/articles/${featured.slug}`} style="color: #38bdf8; text-decoration: none; font-size: 0.95rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                            Read full analysis &rarr;
                        </a>
                    </div>
                </div>
            </section>
        )}

        <!-- Explore the Research / Latest Articles Header -->
        <section style="margin-bottom: 40px;">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b; margin-bottom: 12px;">
                EXPLORE THE RESEARCH
            </div>
            
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; border-bottom: 1px solid #1e293b; padding-bottom: 20px; margin-bottom: 30px;">
                <h3 style="font-size: 1.8rem; font-weight: 800; color: #ffffff; margin: 0;">
                    Latest articles
                </h3>
                <div style="color: #64748b; font-size: 0.85rem;">
                    {others.length + (featured ? 1 : 0)} articles
                </div>
            </div>

            <!-- Search and Filter Bar -->
            <div style="display: grid; grid-template-columns: 1fr 240px; gap: 16px; margin-bottom: 40px;">
                <input type="text" placeholder="Search company, ticker, or topic..." style="background-color: #0b0f17; border: 1px solid #1e293b; border-radius: 10px; padding: 12px 16px; color: #ffffff; font-size: 0.9rem; outline: none;" />
                <select style="background-color: #0b0f17; border: 1px solid #1e293b; border-radius: 10px; padding: 12px 16px; color: #ffffff; font-size: 0.9rem; outline: none;">
                    <option>All categories</option>
                    <option>Smartphones</option>
                    <option>Laptops</option>
                    <option>Benchmarks</option>
                </select>
            </div>
        </section>

        <!-- Grid for Other Articles (2 Columns) -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 30px; margin-bottom: 60px;">
            {others.map((article) => (
                <a href={`/articles/${article.slug}`} style="text-decoration: none; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column;">
                    <div style="width: 100%; height: 200px; background-color: #090d16; border-bottom: 1px solid #1e293b; display: flex; align-items: center; justify-content: center; color: #475569; font-family: monospace; font-size: 0.85rem;">
                        [Gadget Thumbnail]
                    </div>
                    <div style="padding: 28px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; background: rgba(6, 182, 212, 0.1); padding: 4px 10px; border-radius: 6px; margin-bottom: 12px; border: 1px solid rgba(6, 182, 212, 0.2);">
                                {article.data.category}
                            </div>
                            <h4 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0 0 12px 0; line-height: 1.4;">
                                {article.data.title}
                            </h4>
                            <div style="display: flex; gap: 12px; align-items: center; font-size: 0.75rem; color: #64748b; margin-bottom: 14px;">
                                <span style="color: #38bdf8;">$TECH</span>
                                <span>{article.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                                <span>3 min read</span>
                            </div>
                            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin: 0;">
                                {article.data.description}
                            </p>
                        </div>
                    </div>
                </a>
            ))}
        </div>

        <!-- Footer -->
        <footer style="border-top: 1px solid #1e293b; padding-top: 30px; text-align: center; color: #64748b; font-size: 0.85rem; margin-bottom: 40px;">
            &copy; 2026 Benchtekno. Smartphone news, mobile reviews, and hardware insights.
        </footer>

    </main>

</body>
</html>
