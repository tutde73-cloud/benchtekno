---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredArticle = sortedArticles[0];
const recentArticles = sortedArticles.slice(1, 7);
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benchtekno — Global Tech Media & Hardware Reviews</title>
    <meta name="description" content="Deep technical hardware benchmarks, smartphone performance evaluations, and mobile chipset architectural analysis." />
    <link rel="canonical" href="https://www.benchtekno.com/" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.benchtekno.com/" />
    <meta property="og:title" content="Benchtekno — Global Tech Media & Hardware Reviews" />
    <meta property="og:description" content="Deep technical hardware benchmarks, smartphone performance evaluations, and mobile chipset architectural analysis." />
    <meta property="og:image" content="https://www.benchtekno.com/default-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
</head>
<body style="background-color: #07090e; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0;">

    <!-- Navigation Header (Fixed & Clickable) -->
    <header style="border-bottom: 1px solid #1e293b; background-color: #0b0f17; position: sticky; top: 0; z-index: 50;">
        <div style="max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 18px 20px;">
            <a href="/" style="font-size: 1.3rem; font-weight: 900; letter-spacing: 1px; color: #ffffff; text-decoration: none;">
                benchtekno
            </a>
            <nav style="display: flex; gap: 20px; font-size: 0.9rem; font-weight: 600;">
                <a href="#hardware" style="color: #94a3b8; text-decoration: none;">Global Hardware</a>
                <a href="#benchmarks" style="color: #94a3b8; text-decoration: none;">Benchmarks</a>
                <a href="#latest" style="color: #94a3b8; text-decoration: none;">Latest</a>
                <a href="/about" style="color: #38bdf8; text-decoration: none;">About</a>
            </nav>
        </div>
    </header>

    <main style="max-width: 1100px; margin: 0 auto; padding: 40px 20px;">
        
        <!-- Hero Section -->
        <section style="margin-bottom: 60px;">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #38bdf8; margin-bottom: 12px;">
                DATA-DRIVEN HARDWARE COMPARISONS
            </div>
            <h1 style="font-size: 2.8rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.2;">
                Understand the hardware behind the device.
            </h1>
            <p style="color: #94a3b8; font-size: 1.1rem; max-width: 700px; margin: 0 0 24px 0; line-height: 1.6;">
                Benchtekno delivers daily visual benchmark breakdowns, thermal performance analytics, and deep mobile chipset research on high-end hardware.
            </p>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                <span style="background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); padding: 6px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">Performance Benchmarks</span>
                <span style="background: rgba(100, 116, 139, 0.1); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.2); padding: 6px 14px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">Not financial advice</span>
            </div>
            <p style="color: #64748b; font-size: 0.85rem; margin-top: 16px;">
                While others lock their insights behind paywalls and sign-up forms, we give you the analysis upfront.
            </p>
        </section>

        <!-- Editor's Selection / Featured Article -->
        {featuredArticle && (
            <section style="margin-bottom: 60px;" id="hardware">
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b; margin-bottom: 16px;">
                    EDITOR'S SELECTION
                </div>
                <a href={`/articles/${featuredArticle.slug}`} style="text-decoration: none; display: block; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 16px; padding: 30px; transition: border-color 0.2s;">
                    <div style="display: inline-block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; background: rgba(6, 182, 212, 0.1); padding: 4px 10px; border-radius: 6px; margin-bottom: 16px; border: 1px solid rgba(6, 182, 212, 0.2);">
                        {featuredArticle.data.category}
                    </div>
                    <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.3;">
                        {featuredArticle.data.title}
                    </h2>
                    <p style="color: #94a3b8; font-size: 1.05rem; margin: 0 0 20px 0; line-height: 1.6;">
                        {featuredArticle.data.description}
                    </p>
                    <span style="color: #38bdf8; font-weight: 600; font-size: 0.95rem;">Read full technical analysis &rarr;</span>
                </a>
            </section>
        )}

        <!-- Latest Articles / Research Grid -->
        <section id="latest">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;" id="benchmarks">
                <h3 style="font-size: 1.5rem; font-weight: 800; color: #ffffff; margin: 0;">
                    Latest Hardware Research
                </h3>
                <span style="font-size: 0.85rem; color: #64748b;">Showing all publications</span>
            </div>

            {recentArticles.length > 0 ? (
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                    {recentArticles.map((article) => (
                        <a href={`/articles/${article.slug}`} style="text-decoration: none; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; margin-bottom: 10px;">
                                    {article.data.category}
                                </div>
                                <h4 style="font-size: 1.2rem; font-weight: 700; color: #ffffff; margin: 0 0 10px 0; line-height: 1.4;">
                                    {article.data.title}
                                </h4>
                                <p style="color: #94a3b8; font-size: 0.9rem; margin: 0 0 20px 0; line-height: 1.5;">
                                    {article.data.description}
                                </p>
                            </div>
                            <span style="color: #64748b; font-size: 0.8rem;">
                                {new Date(article.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                            </span>
                        </a>
                    ))}
                </div>
            ) : (
                <p style="color: #64748b; text-align: center; padding: 40px 0;">Belum ada artikel tambahan. Silakan buat file Markdown baru di folder `src/content/articles/`.</p>
            )}
        </section>

        <!-- Footer -->
        <footer style="border-top: 1px solid #1e293b; padding-top: 30px; text-align: center; color: #64748b; font-size: 0.85rem; margin-top: 80px; margin-bottom: 40px;">
            &copy; 2026 Benchtekno. Global tech media, mobile reviews, and hardware insights.
        </footer>

    </main>

</body>
</html>
