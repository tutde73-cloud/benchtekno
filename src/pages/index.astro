---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredArticle = sortedArticles[0];
const recentArticles = sortedArticles.slice(1, 7);
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benchtekno — Global Gadget Reviews & Smartphone Benchmarks</title>
    <meta name="description" content="Deep gadget reviews, smartphone performance tests, and comprehensive mobile device benchmarking." />
    <link rel="canonical" href="https://www.benchtekno.com/" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.benchtekno.com/" />
    <meta property="og:title" content="Benchtekno — Global Gadget Reviews & Smartphone Benchmarks" />
    <meta property="og:description" content="Deep gadget reviews, smartphone performance tests, and comprehensive mobile device benchmarking." />
    <meta property="og:image" content="https://www.benchtekno.com/default-og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
</head>
<body style="background-color: #07090e; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0;">

    <!-- Clean Modern Header -->
    <header style="border-bottom: 1px solid #1e293b; background-color: #0b0f17; position: sticky; top: 0; z-index: 50;">
        <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 16px 20px;">
            
            <!-- Left: Hamburger Menu Button -->
            <button id="menu-btn" style="background: none; border: none; cursor: pointer; color: #ffffff; display: flex; align-items: center; padding: 4px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>

            <!-- Center: Logo -->
            <a href="/" style="font-size: 1.5rem; font-weight: 900; letter-spacing: -0.5px; color: #ffffff; text-decoration: none; font-family: monospace;">
                Benchtekno_
            </a>

            <!-- Right: Search Icon -->
            <button style="background: none; border: none; cursor: pointer; color: #ffffff; display: flex; align-items: center; padding: 4px;" title="Search">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </div>
    </header>

    <!-- Hidden Drawer Menu (Slide Down / Toggle) -->
    <div id="mobile-menu" style="display: none; background-color: #0b0f17; border-bottom: 1px solid #1e293b; padding: 20px; position: sticky; top: 65px; z-index: 40;">
        <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
            <a href="/" style="color: #ffffff; text-decoration: none; font-size: 1.1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Home</a>
            <a href="#latest-section" style="color: #94a3b8; text-decoration: none; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Smartphones & Gadgets</a>
            <a href="#latest-section" style="color: #94a3b8; text-decoration: none; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Benchmarks</a>
            <a href="/about" style="color: #38bdf8; text-decoration: none; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">About Portal</a>
        </div>
    </div>

    <!-- Script to toggle menu -->
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        
        menuBtn?.addEventListener('click', () => {
            if (mobileMenu) {
                mobileMenu.style.display = mobileMenu.style.display === 'block' ? 'none' : 'block';
            }
        });
    </script>

    <main style="max-width: 1100px; margin: 0 auto; padding: 40px 20px;">
        
        <!-- Hero Section -->
        <section style="margin-bottom: 60px;">
            <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #38bdf8; margin-bottom: 12px;">
                PROFESSIONAL GADGET & SMARTPHONE REVIEWS
            </div>
            <h1 style="font-size: 2.8rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.2;">
                Unboxing performance behind every gadget.
            </h1>
            <p style="color: #94a3b8; font-size: 1.1rem; max-width: 700px; margin: 0 0 24px 0; line-height: 1.6;">
                Benchtekno delivers honest smartphone performance evaluations, gaming benchmark breakdowns, and deep technical insights into modern gadgets.
            </p>
        </section>

        <!-- Editor's Selection / Featured Article -->
        {featuredArticle && (
            <section style="margin-bottom: 60px;">
                <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #64748b; margin-bottom: 16px;">
                    EDITOR'S SELECTION
                </div>
                <a href={`/articles/${featuredArticle.slug}`} style="text-decoration: none; display: block; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 16px; padding: 30px;">
                    <div style="display: inline-block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; background: rgba(6, 182, 212, 0.1); padding: 4px 10px; border-radius: 6px; margin-bottom: 16px; border: 1px solid rgba(6, 182, 212, 0.2);">
                        {featuredArticle.data.category}
                    </div>
                    <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.3;">
                        {featuredArticle.data.title}
                    </h2>
                    <p style="color: #94a3b8; font-size: 1.05rem; margin: 0 0 20px 0; line-height: 1.6;">
                        {featuredArticle.data.description}
                    </p>
                    <span style="color: #38bdf8; font-weight: 600; font-size: 0.95rem;">Read full gadget review &rarr;</span>
                </a>
            </section>
        )}

        <!-- Latest Articles Section -->
        <section id="latest-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h3 style="font-size: 1.5rem; font-weight: 800; color: #ffffff; margin: 0;">
                    Latest Gadget Research
                </h3>
                <span style="font-size: 0.85rem; color: #64748b;">Showing all publications</span>
            </div>

            {recentArticles.length > 0 ? (
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
                    {recentArticles.map((article) => (
                        <a href={`/articles/${article.slug}`} style="text-decoration: none; background-color: #0f172a; border: 1px solid #1e293b; border-radius: 12px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between;">
                            <div>
                                <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #38bdf8; margin-bottom: 10px;">
                                    {article.data.category}
                                </div>
                                <h4 style="font-size: 1.2rem; font-weight: 700; color: #ffffff; margin: 0 0 10px 0; line-height: 1.4;">
                                    {article.data.title}
                                </h4>
                                <p style="color: #94a3b8; font-size: 0.9rem; margin: 0 0 20px 0; line-height: 1.5;">
                                    {article.data.description}
                                </p>
                            </div>
                            <span style="color: #64748b; font-size: 0.8rem;">
                                {new Date(article.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                            </span>
                        </a>
                    ))}
                </div>
            ) : (
                <p style="color: #64748b; text-align: center; padding: 40px 0;">Belum ada artikel tambahan. Silakan buat file Markdown baru di folder `src/content/articles/`.</p>
            )}
        </section>

        <!-- Footer -->
        <footer style="border-top: 1px solid #1e293b; padding-top: 30px; text-align: center; color: #64748b; font-size: 0.85rem; margin-top: 80px; margin-bottom: 40px;">
            &copy; 2026 Benchtekno. Global gadget reviews, smartphone benchmarks, and tech insights.
        </footer>

    </main>

</body>
</html>
