---
import { getCollection } from 'astro:content';

// Mengambil semua artikel dari folder content collections
const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featured = sortedArticles[0];
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benchtekno — Global Tech Media & Hardware Reviews</title>
</head>
<body style="background-color: #090d16; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 40px 20px;">
    
    <main style="max-width: 900px; margin: 0 auto;">
        <!-- Header / Logo -->
        <header style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #1e293b; padding-bottom: 20px; margin-bottom: 40px;">
            <h1 style="font-size: 1.8rem; font-weight: 900; letter-spacing: 1px; margin: 0; background: linear-gradient(to right, #06b6d4, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                BENCHTEKNO
            </h1>
            <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; color: #06b6d4; background: rgba(6, 182, 212, 0.1); padding: 6px 12px; border-radius: 20px; border: 1px solid rgba(6, 182, 212, 0.2);">
                Global Tech Desk
            </span>
        </header>

        <!-- Hero Article Section -->
        {featured && (
            <section style="background-color: #111827; border: 1px solid #1e293b; border-radius: 16px; padding: 32px; margin-bottom: 40px;">
                <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 16px;">
                    <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #06b6d4; background: rgba(6, 182, 212, 0.1); padding: 4px 10px; border-radius: 6px;">
                        {featured.data.category}
                    </span>
                    <span style="font-size: 0.8rem; color: #94a3b8;">
                        {featured.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </span>
                </div>
                <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0; line-height: 1.3;">
                    {featured.data.title}
                </h2>
                <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin: 0 0 24px 0;">
                    {featured.data.description}
                </p>
                <div style="font-size: 0.9rem; font-weight: 600; color: #38bdf8;">
                    By {featured.data.author}
                </div>
            </section>
        )}

        <!-- Footer Note -->
        <footer style="border-top: 1px solid #1e293b; padding-top: 20px; text-align: center; color: #64748b; font-size: 0.85rem;">
            &copy; 2026 Benchtekno. Independent smartphone news, mobile reviews, and hardware insights.
        </footer>
    </main>

</body>
</html>
