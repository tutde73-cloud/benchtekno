---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featured = sortedArticles[0];
const others = sortedArticles.slice(1);
---

<Layout title="Benchtekno — Global Tech Media & Hardware Reviews">
    
    <!-- Top Navigation Bar -->
    <header class="border-b border-slate-800 bg-[#0b0f17]/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto flex justify-between items-center px-6 py-4">
            <div class="flex items-center gap-10">
                <a href="/" class="text-xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500 uppercase">
                    BENCHTEKNO
                </a>
                <nav class="hidden md:flex gap-8 text-sm font-medium text-slate-400">
                    <span class="hover:text-cyan-400 transition-colors cursor-pointer">Smartphones</span>
                    <span class="hover:text-cyan-400 transition-colors cursor-pointer">Laptops</span>
                    <span class="hover:text-cyan-400 transition-colors cursor-pointer">Benchmarks</span>
                    <span class="hover:text-cyan-400 transition-colors cursor-pointer">Reviews</span>
                </nav>
            </div>
            <div>
                <a href="/about" class="text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-950/40 px-4 py-2 rounded-full border border-cyan-800/50 hover:bg-cyan-900/40 transition-all no-underline">
                    About Desk
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12">
        
        <!-- Hero Section -->
        {featured && (
            <section class="mb-16">
                <!-- Subtitle / Badge -->
                <div class="mb-4">
                    <span class="inline-block text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-950/60 px-3 py-1 rounded-md border border-cyan-800/40">
                        Data-Driven Hardware Comparisons
                    </span>
                </div>

                <div class="bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden shadow-2xl">
                    <div class="w-full h-72 sm:h-96 bg-[#090d16] border-b border-slate-800 flex items-center justify-center text-slate-600 font-mono text-sm tracking-widest">
                        [Featured Hero Image Preview]
                    </div>
                    
                    <div class="p-8 sm:p-10">
                        <div class="flex items-center gap-4 mb-4 text-sm">
                            <span class="font-bold uppercase text-cyan-400 bg-cyan-950/50 px-2.5 py-1 rounded">
                                {featured.data.category}
                            </span>
                            <span class="text-slate-400">
                                {featured.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                            </span>
                        </div>
                        
                        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 leading-tight tracking-tight">
                            {featured.data.title}
                        </h1>
                        
                        <p class="text-slate-400 text-lg leading-relaxed mb-8 max-w-4xl">
                            {featured.data.description}
                        </p>
                        
                        <a href={`/articles/${featured.slug}`} class="inline-flex items-center gap-2 text-cyan-400 font-semibold hover:text-cyan-300 transition-colors no-underline">
                            Read Full Analysis &rarr;
                        </a>
                    </div>
                </div>
            </section>
        )}

        <!-- Section Header -->
        <div class="flex justify-between items-center border-b border-slate-800 pb-4 mb-8">
            <h2 class="text-xl font-bold text-white tracking-wide">
                Latest Hardware & Reviews
            </h2>
            <span class="text-xs font-semibold uppercase tracking-widest text-slate-500">
                Updated Real-Time
            </span>
        </div>

        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
            {others.map((article) => (
                <a href={`/articles/${article.slug}`} class="group bg-slate-900/50 border border-slate-800 rounded-xl overflow-hidden flex flex-col hover:border-slate-700 transition-all no-underline">
                    <div class="w-full h-48 bg-[#090d16] border-b border-slate-800 flex items-center justify-center text-slate-600 font-mono text-xs tracking-wider">
                        [Gadget Thumbnail]
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="text-xs font-bold uppercase tracking-wider text-cyan-400 mb-2">
                                {article.data.category}
                            </div>
                            <h3 class="text-lg font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors leading-snug">
                                {article.data.title}
                            </h3>
                            <p class="text-slate-400 text-sm leading-relaxed mb-4">
                                {article.data.description}
                            </p>
                        </div>
                        <div class="text-xs font-semibold text-cyan-400">
                            Read Article &rarr;
                        </div>
                    </div>
                </a>
            ))}
            
            {others.length === 0 && (
                <div class="col-span-full py-12 text-center bg-slate-900/30 border border-slate-800 rounded-xl text-slate-500 text-sm">
                    More hardware benchmarks and reviews coming soon.
                </div>
            )}
        </div>

        <!-- Footer -->
        <footer class="border-t border-slate-800 pt-8 text-center text-slate-500 text-sm mb-8">
            &copy; 2026 Benchtekno. Smartphone news, mobile reviews, and hardware insights.
        </footer>

    </main>

</Layout>
